{
  "cli": {
    "version": ">= 16.4.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },

    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },

    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_ENABLE_PROGUARD": "true",
        "EXPO_ANDROID_GRADLE_EXTRA_ARGS": "-Pandroid.enableR8.fullMode=true"
      }
    }
  },

  "submit": {
    "production": {}
  }
}